---
title: Tous les épisodes
layout: base.njk
permalink: /episodes/
bodyClass: page-episodes
---
{% set episodesWithTracks = episodes | withTracks %}

<p class="count">{{ episodesWithTracks.length }} épisodes avec playlist (sur {{ episodes.length }} au total)</p>

<div class="episodes-grid">
  {% for episode in episodesWithTracks %}
    {% set realTracks = episode.tracks | realTracks %}
    {% set span = realTracks.length | cardSpan %}
    {% set cols = realTracks.length | innerColumns %}

    <section class="episode-card" style="grid-column: span {{ span }};">
      <h2 title={{ episode.pubDate | humanDate }}>{{ episode.title }}</h2>
      <div class="track-grid" style="grid-template-columns: repeat({{ cols }}, 1fr);">
        {% for track in realTracks %}
        <a class="track-tile" href="{{ track | searchLink }}" target="_blank" rel="noopener">
          <p class="track-artist">{{ track.artist }}</p>
          <p class="track-title">{{ track.title }}</p>
        </a>
        {% endfor %}
      </div>
    </section>
  {% endfor %}
</div>