---
title: Accueil
layout: base.njk
---
{% set latest = episodes[0] %}

<section class="latest-episode">
  <p class="eyebrow">Dernier épisode</p>
  <h2>{{ latest.title }}</h2>
  <p class="date">{{ latest.pubDate | humanDate }}</p>

{% if latest.tracks.length > 0 %}
  <div class="track-grid">
    {% for track in latest.tracks %}
      {% if track.artist != "ALB" %}
        <div class="track-tile">
          <p class="track-artist">{{ track.artist }}</p>
          <p class="track-title">{{ track.title }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% else %}
  <p class="empty">Pas de playlist pour cet épisode.</p>
{% endif %}
</section>

<p class="all-episodes-link"><a href="/episodes/">Voir tous les épisodes →</a></p>