---
title: Accueil
layout: base.njk
---
<p class="count">{{ episodes.length }} épisodes</p>

{% for episode in episodes %}
  <section class="episode">
    <h2>{{ episode.title }}</h2>
    <p class="date">{{ episode.pubDate }}</p>
    {% if episode.tracks.length > 0 %}
      <ul class="tracklist">
        {% for track in episode.tracks %}
          <li><span class="artist">{{ track.artist }}</span> — {{ track.title }}</li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="empty">Pas de playlist pour cet épisode.</p>
    {% endif %}
  </section>
{% endfor %}