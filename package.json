{
  "name": "cosy-corner-playlist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aggregates music track info from Le Cosy Corner podcast episode playlists.",
  "scripts": {
    "build": "tsc",
    "backfill": "tsx src/backfill.ts",
    "typecheck": "tsc --noEmit",
    "site:build": "eleventy",
    "site:serve": "eleventy --serve",
    "stats": "tsx src/stats.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
